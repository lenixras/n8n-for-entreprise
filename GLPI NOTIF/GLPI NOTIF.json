    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT\n  t.id,\n  t.name AS titre,\n  t.content AS description,\n  t.date AS date_creation,\n  u.name AS demandeur,\n  c.completename AS categorie\nFROM glpi_tickets t\nLEFT JOIN glpi_tickets_users tu ON t.id = tu.tickets_id AND tu.type = 1\nLEFT JOIN glpi_users u ON tu.users_id = u.id\nLEFT JOIN glpi_itilcategories c ON t.itilcategories_id = c.id\nWHERE t.status = 1\n  AND t.date >= NOW() - INTERVAL 24 HOUR\nORDER BY t.date ASC;",
        "options": {}
      },
      "id": "9b6e11d0-0e5e-4a48-bac3-b917b3727ab2",
      "name": "2.1 Tickets GLPI (24 h)",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [-1750, -600],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
