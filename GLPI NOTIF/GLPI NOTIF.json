    {
      "parameters": {
        "jsCode": "// Tickets dujour moins les deja notifies, HTML nettoye, message unique construit une seule fois.\nconst tickets = $('2.1 Tickets GLPI (24 h)').all().map((item) => item.json);\nconst dejaNotifies = new Set(\n  $('2.2 Déjà notifiés').all().map((item) => String(item.json.id))\n);\n\nconst decode = (html) => String(html ?? '')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#039;/g, \"'\")\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&');\n\nconst vus = new Set();\nconst sortants = [];\n\nfor (const t of tickets) {\n  const id = String(t && t.id !== undefined ? t.id : '');\n  if (!id || dejaNotifies.has(id) || vus.has(id)) continue;\n  vus.add(id);\n\n  const description = decode(t.description)\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/\\s{2,}/g, ' ')\n    .trim()\n    .substring(0, 3000);\n\n  const demandeur = t.demandeur || 'N/A';\n  const categorie = t.categorie || 'Non définie';\n\n  sortants.push({\n    json: {\n      ...t,\n      description,\n      demandeur,\n      categorie,\n      text:\n        'NOUVEAU TICKET\\n\\n' +\n        'ID: ' + t.id + '\\n' +\n        'Titre: ' + t.titre + '\\n' +\n        'Demandeur: ' + demandeur + '\\n' +\n        'Date: ' + t.date_creation + '\\n' +\n        'Catégorie: ' + categorie + '\\n' +\n        'Description: ' + description,\n    },\n  });\n}\n\nreturn sortants;"
      },
