    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst a = d.agent || {};\nconst serverRole = a.grade === 'administrateur' ? 'Administrateur' : 'Technicien';\nlet steps;\nif (d.type === 'onboarding') {\n  steps = [\n    'Message Teams au gestionnaire stock (demande de materiel)',\n    'Creation login sur AD',\n    'Acces partages',\n  ];\n  if (d.level === 'superviseur' || d.level === 'it') steps.push('Creation compte GLPI');\n  if (d.level === 'it') steps.push('Compte serveur avec role ' + serverRole);\n} else {\n  steps = [\n    'Suppression login AD',\n    'Revocation des acces partages',\n    'Desactivation compte GLPI',\n    'Suppression des comptes serveur',\n  ];\n}\nconst titre = d.type === 'onboarding' ? 'Onboarding' : 'Offboarding';\nconst subject = '[' + titre + '] ' + a.name + ' (' + a.initial + ') - ' + (a.poste || 'poste non precise');\nconst rows = steps.map((s, i) => '<tr><td style=\"padding:6px 10px;border:1px solid #ddd;text-align:center\">' + (i + 1) + '</td><td style=\"padding:6px 10px;border:1px solid #ddd\">' + s + '</td><td style=\"padding:6px 10px;border:1px solid #ddd;color:#1a7f37\">Effectue</td></tr>').join('');\nconst bodyHtml = '<div style=\"font-family:Arial,sans-serif;max-width:640px\">'\n  + '<h2 style=\"color:#0b5fff\">Demande ' + titre.toLowerCase() + ' traitee</h2>'\n  + '<p>Bonjour,</p><p>La demande <b>' + titre.toLowerCase() + '</b> pour <b>' + a.name + '</b> (initials: ' + a.initial + ', poste: ' + (a.poste || '-') + ', grade IT: ' + (a.grade || '-') + ', email: ' + d.email + ') a ete traitee.</p>'\n  + '<table style=\"border-collapse:collapse;width:100%\"><tr><th style=\"padding:6px 10px;border:1px solid #ddd\">#</th><th style=\"padding:6px 10px;border:1px solid #ddd\">Action</th><th style=\"padding:6px 10px;border:1px solid #ddd\">Statut</th></tr>' + rows + '</table>'\n  + '<p style=\"color:#666\">Reference: ' + d.reference + ' — ' + DateTime.now().toFormat('yyyy-MM-dd HH:mm') + '</p></div>';\nconst mailText = 'Bonjour,\\n\\nLa demande ' + titre.toLowerCase() + ' pour ' + a.name + ' (' + a.initial + ') a ete traitee.\\n\\n' + steps.map((s, i) => (i + 1) + '. ' + s + ' - Effectue').join('\\n') + '\\n\\nReference: ' + d.reference;\nreturn [{ json: Object.assign({}, d, { mailSubject: subject, mailBodyHtml: bodyHtml, mailText: mailText }) }];"
      },
