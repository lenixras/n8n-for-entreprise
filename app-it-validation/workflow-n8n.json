          "name": "X-App-Token"
        }
      },
      "notes": "Endpoint écoute l'app : POST /webhook/app-it-validation avec header X-App-Token"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body || $input.first().json;\nconst email = String(raw.email || '').trim();\nconst agent = raw.agent || {};\nconst name = String(agent.name || '').trim();\nconst initial = String(agent.initial || '').trim();\nconst poste = String(agent.poste || '').trim();\nconst grade = String(agent.grade || '').trim().toLowerCase();\nconst type = String(raw.type || 'onboarding').trim().toLowerCase();\nconst validationMail = String(raw.validation_mail || '').trim().toUpperCase();\nconst errors = [];\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('email invalide');\nif (!name) errors.push('name agent manquant');\nif (!['onboarding', 'offboarding'].includes(type)) errors.push('type inconnu (attendu: onboarding|offboarding)');\nif (type === 'onboarding' && !['administrateur', 'technicien', 'stock', 'manager'].includes(grade)) errors.push('grade IT invalide (attendu: administrateur|technicien|stock|manager)');\nlet level = 'simple';\nif (['administrateur', 'technicien'].includes(grade)) level = 'it';\nelse if (grade === 'manager') level = 'superviseur';\nreturn [{ json: { valid: errors.length === 0, errors, validation_mail: validationMail, type, level, email, agent: { name, initial, poste, grade }, reference: 'IT-' + Date.now() } }];"
      },
      "id": "cb54cd10-a70d-4438-9a83-11671ab7fac4",
      "name": "Valider payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        464
      ],
      "notes": "Normalise le payload et derive le niveau: administrateur/technicien=it, manager=superviseur, stock/autres=simple"
    },
